{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:5186/lingxing-erp/"
